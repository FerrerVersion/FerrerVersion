{% from "partials/icons.njk" import icon %}
{% from "partials/project-card.njk" import card %}
{% set h = home[lang] %}

<section class="hero" data-hero>
  <svg class="hero__grain" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <filter id="fv-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch"></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
    </filter>
    <rect width="100%" height="100%" filter="url(#fv-grain)"></rect>
  </svg>
  <div class="container hero__inner">
    <p class="hero__name">{{ h.hero.name }}</p>
    <p class="kicker">{{ h.hero.kicker }}</p>
    <h1 class="hero__headline">
      {% for line in h.hero.headlineLines %}
      <span class="reveal-line"><span>{{ line }}</span></span>
      {% endfor %}
    </h1>

    <div class="hero__rule-wrap" aria-hidden="true">
      <svg viewBox="0 0 420 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 14 C 110 2, 310 24, 418 10" stroke="var(--gold)" stroke-width="1.5" />
      </svg>
    </div>

    <p class="hero__lede">{{ h.hero.lede }}</p>

    <div class="hero__actions">
      <a class="btn btn-primary" href="{{ ('/' if lang == 'es' else '/en/') | url }}#contacto">
        {{ h.hero.ctaPrimary }} {{ icon("arrow-right") }}
      </a>
      <a class="btn btn-secondary" href="{{ ('/' if lang == 'es' else '/en/') | url }}#proyectos">
        {{ h.hero.ctaSecondary }}
      </a>
      <a class="btn btn-ghost" href="{{ site.contact.githubHref }}" target="_blank" rel="noopener">
        {{ icon("github") }} {{ h.hero.ctaGithub }}
      </a>
    </div>

    <dl class="hero__meta">
      {% for item in h.hero.meta %}
      <div class="hero__meta-item">
        <dt>{{ item.label }}</dt>
        <dd>{{ item.value }}</dd>
      </div>
      {% endfor %}
    </dl>
  </div>
</section>

<section class="section" id="propuesta" data-reveal>
  <div class="container value-prop__grid">
    <div>
      <p class="kicker">{{ h.valueProp.kicker }}</p>
      <p class="value-prop__lead">{{ h.valueProp.leadBefore }}<em>{{ h.valueProp.leadEm }}</em>{{ h.valueProp.leadAfter }}</p>
    </div>
    <div class="value-prop__body">
      {% for p in h.valueProp.paragraphs %}
      <p>{{ p }}</p>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt" id="servicios" data-reveal>
  <div class="container">
    <div class="section__head">
      <p class="kicker">{{ h.services.kicker }}</p>
      <h2>{{ h.services.heading }}</h2>
      <p>{{ h.services.lead }}</p>
    </div>
    <div class="services__list">
      {% for s in h.services.items %}
      <div class="service-row">
        <div class="service-row__head">
          <span class="icon-badge">{{ icon(s.icon) }}</span>
          <h3 class="service-row__title">{{ s.title }}</h3>
        </div>
        <div>
          <p class="service-row__desc">{{ s.desc }}</p>
          <div class="service-row__examples">
            {% for ex in s.examples %}
            <span class="tag">{{ ex }}</span>
            {% endfor %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="proceso" data-reveal>
  <div class="container">
    <div class="section__head">
      <p class="kicker">{{ h.process.kicker }}</p>
      <h2>{{ h.process.heading }}</h2>
      <p>{{ h.process.lead }}</p>
    </div>
    <ol class="process__list">
      {% for step in h.process.steps %}
      <li class="process-step">
        <h3 class="process-step__title">{{ step.title }}</h3>
        <p class="process-step__desc">{{ step.desc }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{% set mobii = projects | findAlt("mobii") %}
{% if mobii %}
{% set mc = mobii[lang] %}
<section class="section section--alt" id="caso-destacado" data-reveal>
  <div class="container">
    <div class="section__head">
      <p class="kicker">{{ h.featuredCase.kicker }}</p>
      <h2>{{ h.featuredCase.heading }}</h2>
      <p>{{ h.featuredCase.lead }}</p>
    </div>

    <div class="featured-case">
      {% if mobii.images and mobii.images.length > 0 %}
      <div class="featured-case__media">
        <img src="{{ mobii.images[0].src | url }}" alt="{{ mobii.images[0].caption[lang] or mc.nombre }}" loading="lazy" />
      </div>
      {% endif %}

      <div class="featured-case__flow">
        <div class="featured-case__step">
          <p class="case-block__title">{{ t.case.problema }}</p>
          <p class="case-block__text">{{ mc.problema }}</p>
        </div>
        <div class="featured-case__step">
          <p class="case-block__title">{{ t.case.solucion }}</p>
          <p class="case-block__text">{{ mc.solucion }}</p>
        </div>
        {% if mc.funcionalidades %}
        <div class="featured-case__step">
          <p class="case-block__title">{{ t.case.funcionalidades }}</p>
          <ul class="featured-case__list">
            {% for item in mc.funcionalidades %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        <div class="featured-case__step">
          <p class="case-block__title">{{ t.case.tecnologias }}</p>
          <div class="featured-case__tags">
            {% for item in mobii.tech %}<span class="tag">{{ item }}</span>{% endfor %}
          </div>
        </div>
        {% if mc.resultado %}
        <div class="featured-case__step">
          <p class="case-block__title">{{ t.case.resultado }}</p>
          <p class="case-block__text">{{ mc.resultado }}</p>
        </div>
        {% endif %}
      </div>
    </div>

    <div class="featured-case__actions">
      <a class="btn btn-primary" href="{{ (("/proyectos/" if lang == "es" else "/en/proyectos/") + mobii.slug + "/") | url }}">
        {{ t.case.verProyectoCompleto }} {{ icon("arrow-right") }}
      </a>
      {% if mobii.links.memoria %}
      <a class="btn btn-secondary" href="{{ mobii.links.memoria | url }}">
        {{ t.case.verMemoria }} {{ icon("arrow-up-right") }}
      </a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<section class="section" id="proyectos" data-reveal>
  <div class="container">
    <div class="section__head">
      <p class="kicker">{{ h.portfolio.kicker }}</p>
      <h2>{{ h.portfolio.heading }}</h2>
      <p>{{ h.portfolio.lead }}</p>
    </div>

    {% set appProjects = projects | whereCategory("app") %}
    {% set webProjects = projects | whereCategory("web") %}

    {% if appProjects.length > 0 %}
    <div class="portfolio-group">
      <p class="portfolio-group__title">{{ h.portfolio.appsLabel }}</p>
      <div class="portfolio-carousel" data-carousel>
        <div class="portfolio-carousel__track" data-carousel-track>
          {% for project in appProjects %}
          <div class="portfolio-carousel__slide" data-carousel-slide>
            {{ card(project, loop.index, lang, t) }}
          </div>
          {% endfor %}
        </div>
        {% if appProjects.length > 1 %}
        <button class="carousel__arrow carousel__arrow--prev" type="button" data-carousel-prev aria-label="{{ 'Anterior' if lang == 'es' else 'Previous' }}">{{ icon("arrow-right") }}</button>
        <button class="carousel__arrow carousel__arrow--next" type="button" data-carousel-next aria-label="{{ 'Siguiente' if lang == 'es' else 'Next' }}">{{ icon("arrow-right") }}</button>
        {% endif %}
      </div>
      {% if appProjects.length > 1 %}
      <div class="carousel__dots" data-carousel-dots role="tablist" aria-label="{{ h.portfolio.appsLabel }}">
        {% for project in appProjects %}
        <button class="carousel__dot" type="button" data-carousel-dot="{{ loop.index0 }}" aria-label="{{ h.portfolio.appsLabel }} {{ loop.index }}"></button>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endif %}

    {% if webProjects.length > 0 %}
    <div class="portfolio-group">
      <p class="portfolio-group__title">{{ h.portfolio.webLabel }}</p>
      <div class="portfolio-carousel" data-carousel>
        <div class="portfolio-carousel__track" data-carousel-track>
          {% for project in webProjects %}
          <div class="portfolio-carousel__slide" data-carousel-slide>
            {{ card(project, loop.index, lang, t) }}
          </div>
          {% endfor %}
        </div>
        {% if webProjects.length > 1 %}
        <button class="carousel__arrow carousel__arrow--prev" type="button" data-carousel-prev aria-label="{{ 'Anterior' if lang == 'es' else 'Previous' }}">{{ icon("arrow-right") }}</button>
        <button class="carousel__arrow carousel__arrow--next" type="button" data-carousel-next aria-label="{{ 'Siguiente' if lang == 'es' else 'Next' }}">{{ icon("arrow-right") }}</button>
        {% endif %}
      </div>
      {% if webProjects.length > 1 %}
      <div class="carousel__dots" data-carousel-dots role="tablist" aria-label="{{ h.portfolio.webLabel }}">
        {% for project in webProjects %}
        <button class="carousel__dot" type="button" data-carousel-dot="{{ loop.index0 }}" aria-label="{{ h.portfolio.webLabel }} {{ loop.index }}"></button>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
</section>

<section class="section section--alt" id="sobre-mi" data-reveal>
  <div class="container about__grid">
    <div>
      <p class="kicker">{{ h.about.kicker }}</p>
      <h2>{{ h.about.heading }}</h2>
      <div class="timeline" style="margin-top: var(--sp-12);">
        {% for item in h.about.timeline %}
        <div class="timeline-item">
          <p class="timeline-item__period">{{ item.period }}</p>
          <p class="timeline-item__title">{{ item.title }}</p>
          <p class="timeline-item__place">{{ item.place }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
    <div class="about__body">
      {% for p in h.about.paragraphs %}
      <p>{{ p | safe }}</p>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="capacidades" data-reveal>
  <div class="container">
    <div class="section__head">
      <p class="kicker">{{ h.capabilities.kicker }}</p>
      <h2>{{ h.capabilities.heading }}</h2>
      <p>{{ h.capabilities.lead }}</p>
    </div>
    <div class="capabilities__groups">
      {% for group in h.capabilities.groups %}
      <div class="capability-group">
        <p class="capability-group__title">{{ group.title }}</p>
        <div class="capability-group__items">
          {% for item in group.items %}
          <span class="capability-pill">{{ item }}</span>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt" id="para-tu-negocio" data-reveal>
  <div class="container">
    <div class="section__head section__head--center">
      <p class="kicker">{{ h.forBusiness.kicker }}</p>
      <h2>{{ h.forBusiness.heading }}</h2>
      <p>{{ h.forBusiness.lead }}</p>
    </div>
    <ul class="for-business__list">
      {% for example in h.forBusiness.examples %}
      <li>{{ icon("arrow-right") }} <span>{{ example }}</span></li>
      {% endfor %}
    </ul>
    <div class="for-business__cta">
      <a class="btn btn-primary" href="{{ ('/' if lang == 'es' else '/en/') | url }}#contacto">
        {{ h.forBusiness.cta }} {{ icon("arrow-right") }}
      </a>
    </div>
  </div>
</section>

<section class="section cta-final" data-reveal>
  <div class="container">
    <h2 class="cta-final__headline">{{ h.ctaFinal.headline }}</h2>
    <p class="cta-final__sub">{{ h.ctaFinal.sub }}</p>
    <div class="cta-final__actions">
      <a class="btn btn-primary" href="{{ ('/' if lang == 'es' else '/en/') | url }}#contacto">
        {{ h.ctaFinal.cta }} {{ icon("arrow-right") }}
      </a>
    </div>
  </div>
</section>

<section class="section section--alt" id="contacto" data-reveal>
  <div class="container contact__grid">
    <div>
      <p class="kicker">{{ h.contact.kicker }}</p>
      <p class="contact__intro">{{ h.contact.intro }}</p>
      <p style="color: var(--ink-muted); margin-top: var(--sp-4); max-width: 32ch;">{{ h.contact.sub }}</p>
    </div>
    <div class="contact__channels">
    <ul class="contact-list">
      <li class="contact-list__item">
        <span class="contact-list__label">{{ h.contact.labels.email }}</span>
        {% if site.contact.emailHref %}
        <a class="contact-list__value link-underline" href="{{ site.contact.emailHref }}">{{ site.contact.email }}</a>
        {% else %}
        <span class="contact-list__value placeholder-note">{{ site.contact.email }}</span>
        {% endif %}
      </li>
      <li class="contact-list__item">
        <span class="contact-list__label">{{ h.contact.labels.whatsapp }}</span>
        {% if site.contact.whatsappHref %}
        <a class="contact-list__value link-underline" href="{{ site.contact.whatsappHref }}">{{ site.contact.whatsapp }}</a>
        {% else %}
        <span class="contact-list__value placeholder-note">{{ site.contact.whatsapp }}</span>
        {% endif %}
      </li>
      <li class="contact-list__item">
        <span class="contact-list__label">{{ h.contact.labels.github }}</span>
        {% if site.contact.githubHref %}
        <a class="contact-list__value link-underline" href="{{ site.contact.githubHref }}">{{ site.contact.github }}</a>
        {% else %}
        <span class="contact-list__value placeholder-note">{{ site.contact.github }}</span>
        {% endif %}
      </li>
      <li class="contact-list__item">
        <span class="contact-list__label">{{ h.contact.labels.linkedin }}</span>
        {% if site.contact.linkedinHref %}
        <a class="contact-list__value link-underline" href="{{ site.contact.linkedinHref }}">{{ site.contact.linkedin }}</a>
        {% else %}
        <span class="contact-list__value placeholder-note">{{ site.contact.linkedin }}</span>
        {% endif %}
      </li>
      {% if site.cv %}
      <li class="contact-list__item">
        <span class="contact-list__label">{{ h.contact.labels.cv }}</span>
        <a class="contact-list__value link-underline" href="{{ site.cv | url }}">{{ "Descargar en PDF" if lang == "es" else "Download as PDF" }}</a>
      </li>
      {% endif %}
    </ul>

    <form class="contact-form" data-contact-form data-mail="{{ site.contact.email }}" data-subject="{{ t.contactForm.mailSubject }}" action="mailto:{{ site.contact.email }}" method="post" enctype="text/plain">
      <p class="contact-form__heading">{{ h.contact.formHeading }}</p>

      <div class="field">
        <label for="cf-nombre">{{ t.contactForm.nombre }}</label>
        <input type="text" id="cf-nombre" name="nombre" placeholder="{{ t.contactForm.nombrePlaceholder }}" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="cf-email">{{ t.contactForm.email }}</label>
        <input type="email" id="cf-email" name="email" placeholder="{{ t.contactForm.emailPlaceholder }}" autocomplete="email" required />
      </div>

      <div class="field">
        <label for="cf-tipo">{{ t.contactForm.tipoProyecto }}</label>
        <select id="cf-tipo" name="tipo">
          <option value="" disabled selected>{{ t.contactForm.tipoProyectoPlaceholder }}</option>
          {% for opt in t.contactForm.tipoProyectoOptions %}
          <option value="{{ opt }}">{{ opt }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="field">
        <label for="cf-mensaje">{{ t.contactForm.mensaje }}</label>
        <textarea id="cf-mensaje" name="mensaje" placeholder="{{ t.contactForm.mensajePlaceholder }}" required></textarea>
      </div>

      <button type="submit" class="btn btn-primary">
        {{ t.contactForm.enviar }} {{ icon("send") }}
      </button>

      <p class="contact-form__note">{{ t.contactForm.mailtoNote }}</p>
    </form>
    </div>
  </div>
</section>
